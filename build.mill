//| mvnDeps:
//| - com.lihaoyi::mill-contrib-scoverage:1.0.3
//| mill-opts: ["--ticker=false"]

package build

import mill.*, scalalib.*
import mill.api.BuildCtx
import mill.contrib.scoverage.ScoverageModule
import os.Path
import mainargs.{arg, Flag}


trait MyModule extends ScoverageModule {
  def scalaVersion     = "3.7.0"
  def scoverageVersion = "2.1.1"

  val zioVersion         = "2.1.25"
  val zioCatsVersion     = "23.1.0.13"
  val scala3mockVersion  = "0.6.6"
  val scalaMockVersion   = "7.5.5"
  val logbackVersion     = "1.5.32"
  val scalaXmlVersion    = "2.4.0"
  val scalaParserVersion = "2.4.0"
  val zioHttpVersion     = "3.11.0"
  val circeVersion       = "0.14.15"
  val quillVersion       = "4.8.6"
  val h2Version          = "2.4.240"
  val tapirVersion       = "1.13.17"
  val requestsVersion    = "0.9.3"
  val pureconfigVersion  = "0.17.10"
  val utestVer           = "0.9.5"

  val deps = Seq(
    mvn"javax.inject:javax.inject:1",
    mvn"com.google.inject:guice:7.0.0",
    mvn"com.h2database:h2:$h2Version",
    mvn"org.scala-lang.modules::scala-parser-combinators:$scalaParserVersion",
    mvn"org.scala-lang.modules::scala-xml:$scalaXmlVersion",
    mvn"org.json4s::json4s-native:4.0.7",
    mvn"dev.zio::zio:$zioVersion",
    mvn"dev.zio::zio-interop-cats:$zioCatsVersion",
    mvn"com.lihaoyi::requests:$requestsVersion",
    mvn"com.github.pureconfig::pureconfig-core:$pureconfigVersion",
    mvn"io.getquill::quill-jdbc:$quillVersion",
    mvn"io.getquill::quill-jdbc-zio:$quillVersion"
  )

  val circeDeps = Seq(
    mvn"io.circe::circe-core:$circeVersion",
    mvn"io.circe::circe-generic:$circeVersion",
    mvn"io.circe::circe-parser:$circeVersion"
  )

  val logbackDeps = Seq(mvn"ch.qos.logback:logback-classic:$logbackVersion")

  object test extends ScoverageTests with TestModule.Utest {

    def mvnDeps = Seq(
      mvn"com.lihaoyi::utest:$utestVer",
      mvn"org.scalamock::scalamock:$scalaMockVersion",
      mvn"eu.monniot::scala3mock:$scala3mockVersion",
      mvn"eu.monniot::scala3mock-scalatest:$scala3mockVersion"
    )
  }

  def scalacOptions = Seq("-deprecation", "-Xfatal-warnings")
}

/**
 * Core models and functionality. This will have the base Card and Deck models, plus calculations.
 * Also included are mechanisms to find cards, whether it be by going to a file, going to a
 * database, or to a web service
 */
object core extends MyModule {
  def mvnDeps = deps ++ circeDeps ++ logbackDeps
}

/**
 * Card loaders, deck loaders, and other deck manipulations
 */
object deckWork extends MyModule {
  def mvnDeps = deps ++ circeDeps ++ logbackDeps
  def moduleDeps = Seq(core)
}

/** ZIO Https implementations */
object zioWeb extends MyModule {

  val zioWebDeps = Seq(
    mvn"dev.zio::zio-http:$zioHttpVersion"
  )

  def mvnDeps = deps ++ circeDeps ++ logbackDeps ++ zioWebDeps

  def moduleDeps = Seq(core, deckWork)
}

/**
 * Tapir Endpoints
 */
object tapir extends MyModule {

  val tapirDeps = Seq(
    mvn"com.softwaremill.sttp.tapir::tapir-zio-http-server:$tapirVersion",
    mvn"com.softwaremill.sttp.tapir::tapir-prometheus-metrics:$tapirVersion",
    mvn"com.softwaremill.sttp.tapir::tapir-swagger-ui-bundle:$tapirVersion",
    mvn"com.softwaremill.sttp.tapir::tapir-json-zio:$tapirVersion"
  )

  def mvnDeps   = deps ++ circeDeps ++ logbackDeps ++ tapirDeps
  def moduleDeps = Seq(zioWeb)
}

/**
 * Create a Docker image and release it under the current version. If configured
 * to `release`, will also advance the version by writing into "version.txt",
 * and create the image under the new version
 *
 * Examples:
 * `./mill dockerBuild`
 * `./mill dockerBuild --release`
 *
 * @param release If active, will advance the version before building the image
 */
def dockerBuild(@arg(doc = "If set, will release a new version")
                release: Flag) = Task.Command {

  tapir.assembly()

  if (release.value)
    bumpVersion(BuildCtx.workspaceRoot)

  val version = currentVersion(BuildCtx.workspaceRoot).asRelease
  val dockerImageName = "deckinfo"
  val dockerFile = BuildCtx.workspaceRoot / "Dockerfile"

  os.proc("docker", "build", "-f", dockerFile,
          "-t", s"$dockerImageName",
          "-t", s"$dockerImageName:$version", BuildCtx.workspaceRoot)
    .call()
}

/**
 * Move applications version to next
 * @param root Path to project root, so we can find the version file
 */
def bumpVersion(root: Path) = {
  val version = currentVersion(root).asRelease
  val next = version.asRC.next
  println(s"Moving version $version → $next")
  writeVersion(next, root)
}

def bump() = Task.Command {
  bumpVersion(BuildCtx.workspaceRoot)
}


def start = Task.Worker {
  tapir.run()
}


def appVersion = Task {
  println(currentVersion(BuildCtx.workspaceRoot))
}
